# Postgres — Vercel: Storage -> Create Database -> Postgres (Neon)
# Se agrega automáticamente al conectar la base de datos al proyecto.
DATABASE_URL=

# Vercel Blob — Storage -> Create Database -> Blob
# Se agrega automáticamente al conectar el almacén de Blob al proyecto.
BLOB_READ_WRITE_TOKEN=

# Clave para entrar al panel /admin como administrador (acceso completo).
ADMIN_PASSWORD=

# Clave para que la vendedora entre a /admin con acceso limitado
# (Ventas, Crédito/Pandero, ver sus Comisiones). Opcional: si no la configuras,
# solo se puede entrar como administrador.
SELLER_PASSWORD=

# Cadena aleatoria y larga usada para firmar la sesión del admin.
# Genera una con: openssl rand -hex 32
SESSION_SECRET=

# ---------- Agente: informe semanal (Reportes → Informe semanal) ----------
# Opcional y DE PAGO: clave de la API de Claude (console.anthropic.com). Sin ella
# el informe es gratis: el análisis se arma con reglas a partir de tus datos.
ANTHROPIC_API_KEY=

# Envío por correo con Resend (resend.com → API Keys). Sin dominio verificado,
# Resend solo envía al correo con el que creaste la cuenta.
RESEND_API_KEY=
# A quién se envía (puedes poner varios separados por coma).
INFORME_EMAIL_TO=
# Opcional: remitente. Por defecto "Alvian Informe <onboarding@resend.dev>".
INFORME_EMAIL_FROM=

# Protege la tarea programada de los lunes (vercel.json → crons).
# Genera una con: openssl rand -hex 32
CRON_SECRET=
