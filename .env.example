# Postgres — Vercel: Storage -> Create Database -> Postgres (Neon)
# Se agrega automáticamente al conectar la base de datos al proyecto.
DATABASE_URL=

# Vercel Blob — Storage -> Create Database -> Blob
# Se agrega automáticamente al conectar el almacén de Blob al proyecto.
BLOB_READ_WRITE_TOKEN=

# Clave para entrar al panel /admin como administrador (acceso completo).
ADMIN_PASSWORD=

# Clave para que la vendedora entre a /admin con acceso limitado
# (Ventas, Crédito/Pandero, ver sus Comisiones). Opcional: si no la configuras,
# solo se puede entrar como administrador.
SELLER_PASSWORD=

# Cadena aleatoria y larga usada para firmar la sesión del admin.
# Genera una con: openssl rand -hex 32
SESSION_SECRET=
